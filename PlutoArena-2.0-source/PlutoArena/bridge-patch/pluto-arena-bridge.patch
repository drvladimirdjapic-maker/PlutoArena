+void LegacyView::load_tuning() {
+  auto number=[](const char* name)->double{
+    char buffer[32]={};
+    DWORD n=GetEnvironmentVariableA(name,buffer,sizeof(buffer));
+    if(n==0 || n>=sizeof(buffer))return 0;
+    double value=std::atof(buffer);
+    return value>0?value:0;
+  };
+  reaction_ms=static_cast<int>(number("PLUTO_REACTION_MS"));
+  double apm_value=number("PLUTO_APM");
+  // Pluto Arena rematch: bridge.ini (next to this DLL) can set new values for
+  // the next game without restarting StarCraft. -1 = not set, keep the above.
+  {
+    HMODULE self=nullptr;wchar_t path[MAX_PATH]={};
+    if(GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS|GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+         reinterpret_cast<LPCWSTR>(&LegacyView::flush_turn),&self) && GetModuleFileNameW(self,path,MAX_PATH)) {
+      std::wstring ini(path);
+      const auto slash=ini.find_last_of(L"\\/");
+      ini=(slash==std::wstring::npos?std::wstring():ini.substr(0,slash+1))+L"bridge.ini";
+      const int r=static_cast<int>(GetPrivateProfileIntW(L"pluto",L"reaction_ms",-1,ini.c_str()));
+      const int a=static_cast<int>(GetPrivateProfileIntW(L"pluto",L"apm",-1,ini.c_str()));
+      if(r>=0)reaction_ms=r;
+      if(a>=0)apm_value=a;
+    }
+  }
+  if(reaction_ms>5000)reaction_ms=5000;
+  // StarCraft "Fastest" runs at about 23.8 frames per second (42 ms per frame).
+  delay_frames=(reaction_ms+21)/42;
+  apm_limit=apm_value;
+  if(apm_limit>0 && apm_limit<10)apm_limit=10;
+  max_tokens=apm_limit>0?(std::max)(4.0,apm_limit/30.0):0;
+  tokens=max_tokens;
+  dropped_stale=0;
+  tuning_logged=false;
 }
 void LegacyView::begin_frame(FILE* log,int frame) {
   current_view=this;frame_log=log;frame_number=frame;sent=0;
+  if(!tuning_logged && log) {
+    std::fprintf(log,"{\"stage\":\"difficulty\",\"reaction_ms\":%d,\"delay_frames\":%d,\"apm\":%d}\n",
+      reaction_ms,delay_frames,static_cast<int>(apm_limit));
+    tuning_logged=true;
