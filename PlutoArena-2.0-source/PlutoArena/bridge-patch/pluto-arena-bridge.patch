+}
+// Sends the pending turns that are due at "frame". Turns queued in frame N are
+// due from frame N+1+delay_frames.
+void LegacyView::flush_pending(FILE* log,int frame) {
   const auto send=reinterpret_cast<void (__cdecl*)(const uint8_t*,size_t)>(scr::send_command());
+  // Commands that waited more than ~1 s beyond the reaction delay are dropped:
+  // Pluto should act on the current situation, not on one from seconds ago.
+  const int stale_frames=delay_frames+24;
   for(auto turn=pending_turns.begin();turn!=pending_turns.end();) {
-    if(turn->frame>=frame){++turn;continue;}
+    // Original behaviour kept one frame; the reaction delay adds more.
+    if(turn->frame+delay_frames>=frame){++turn;continue;}
+    if(apm_limit>0) {
+      if(frame-turn->frame>stale_frames) {
+        ++dropped_stale;
+        turn=pending_turns.erase(turn);
+        continue;
+      }
+      // Selections (0x63) are free; every other packet is one action.
+      double cost=0;
+      for(const auto& packet:turn->packets)if(!packet.empty() && packet[0]!=0x63)cost+=1;
+      if(cost<1)cost=1;
+      // Not enough budget yet: wait, and keep the order of later turns.
+      // A turn bigger than the whole budget goes out once the budget is
+      // full; the extra actions are "owed" (tokens below zero).
+      if(tokens<(std::min)(cost,max_tokens))break;
+      tokens-=cost;
+    }
     for(const auto& packet:turn->packets) {
       send(packet.data(),packet.size());++sent;
       std::fprintf(log,"{\"command_frame\":%d,\"queued_frame\":%d,\"packet_hex\":\"",frame,turn->frame);
