diff --git a/scripts/build-arena.ps1 b/scripts/build-arena.ps1
new file mode 100644
index 0000000..48504fa
--- /dev/null
+++ b/scripts/build-arena.ps1
@@ -0,0 +1,34 @@
+<#
+  Builds the Pluto Arena bridge (pluto-scr-tuned.dll: difficulty ranks +
+  support for Pluto cog2026-2578600 and Pluto v2.0) and copies it to the
+  places Pluto Arena reads difficulty DLLs from.
+
+  Run in this folder (Pluto-AI-Starcraft-Remaster):
+      powershell -ExecutionPolicy Bypass -File .\scripts\build-arena.ps1
+
+  Needs Visual Studio 2022 (or Build Tools) with "Desktop development with C++"
+  (MSVC x86/x64, Windows SDK, C++ CMake tools).
+#>
+$ErrorActionPreference = 'Stop'
+$projectRoot = Split-Path $PSScriptRoot -Parent
+
+Write-Host '== Building the bridge (Win32 Release)' -ForegroundColor Cyan
+& (Join-Path $PSScriptRoot 'build.ps1')
+
+$built = Join-Path $projectRoot 'bin\pluto-scr.dll'
+if (-not (Test-Path -LiteralPath $built)) { throw "Build output missing: $built" }
+
+$targets = @(
+  (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'PlutoDifficultyPack\modes'),
+  (Join-Path $env:LOCALAPPDATA 'Programs\PlutoArena\modes')
+)
+
+foreach ($folder in $targets) {
+  if (Test-Path -LiteralPath $folder) {
+    Copy-Item -LiteralPath $built -Destination (Join-Path $folder 'pluto-scr-tuned.dll') -Force
+    Write-Host "Copied to $folder\pluto-scr-tuned.dll" -ForegroundColor Green
+  }
+}
+
+Write-Host ''
+Write-Host 'Done. Pluto Arena now uses the new bridge (ranks A-F, Pluto 1.0 and 2.0).' -ForegroundColor Green
